# Server-only. Jangan pernah diberi prefix NEXT_PUBLIC_ (aturan 6).
# Nilai bawaan penganalisis cut (claude | codex). Pengguna bisa memilih lain per analisis di UI.
# Memakai CLI yang sudah login, tanpa API key.
ANALYZER_DEFAULT=claude
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Boleh publik (anon key saja, bukan service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker (opsional). Bawaan: model small, bahasa auto.
# Kualitas bahasa campuran ID-EN: coba small/medium; large-v3-turbo butuh RAM/CPU lebih besar.
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
# WHISPER_CPP_VERSION=1.5.5
# FFMPEG_PATH=
# FFPROBE_PATH=
# WORKER_CACHE_DIR=.cache

# Folder penyimpanan video (bawaan: <repo>/data/media). Boleh diarahkan ke drive lain.
# MEDIA_DIR=
